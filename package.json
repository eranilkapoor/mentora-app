{
  "name": "match-mate-app",
  "version": "1.0.0",
  "private": true,
  "description": "Repository-level tooling for Match Mate API and mobile applications.",
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint:api && npm run lint:mobile",
    "lint:api": "npm --prefix match-mate-api-server run lint:check",
    "lint:mobile": "npm --prefix match-mate-mobile-app run lint",
    "format:check": "npm run format:check:api && npm run format:check:mobile",
    "format:check:api": "npm --prefix match-mate-api-server run format:check",
    "format:check:mobile": "npm --prefix match-mate-mobile-app run format:check",
    "typecheck:api": "npm --prefix match-mate-api-server run typecheck",
    "typecheck:mobile": "npm --prefix match-mate-mobile-app run typecheck",
    "build:api": "npm --prefix match-mate-api-server run build",
    "test:api": "npm --prefix match-mate-api-server run test -- --runInBand",
    "test:mobile": "npm --prefix match-mate-mobile-app run test",
    "i18n:check": "npm --prefix match-mate-mobile-app run i18n:check",
    "migration:validate": "npm --prefix match-mate-api-server run migration:validate",
    "contracts:snapshot": "node scripts/snapshot-openapi.mjs",
    "contracts:generate": "openapi-typescript packages/api-contract/openapi.json --output packages/api-contract/src/generated.ts --immutable --alphabetize",
    "contracts:check": "npm run contracts:generate -- --check",
    "verify": "npm run lint && npm run typecheck:api && npm run typecheck:mobile && npm run contracts:check && npm run migration:validate && npm run build:api",
    "ci": "npm run verify && npm run test:api && npm run test:mobile && npm run i18n:check"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  }
}
