{
  "expo": {
    "name": "Match Mate",
    "slug": "match-mate-mobile-app",
    "version": "1.0.1",
    "scheme": "matchmate",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webnza.matchmate",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow Match Mate to use your location to show nearby matrimonial matches. / नजदीकी वैवाहिक मैच दिखाने के लिए Match Mate को आपका स्थान उपयोग करने दें।"
      },
      "associatedDomains": [
        "applinks:matchmate.webnza.com",
        "applinks:www.matchmate.webnza.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "com.android.vending.BILLING"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "matchmate.webnza.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "www.matchmate.webnza.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "matchmate.webnza.com",
              "pathPrefix": "/magic-login"
            },
            {
              "scheme": "https",
              "host": "www.matchmate.webnza.com",
              "pathPrefix": "/magic-login"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "matchmate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.webnza.matchmate"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3378719c-798c-4ae3-ae74-18602b1267eb"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fff7fb",
          "image": "./src/assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Match Mate to use your location to show nearby matrimonial matches. / नजदीकी वैवाहिक मैच दिखाने के लिए Match Mate को आपका स्थान उपयोग करने दें।"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Match Mate to access your photos for profile photo upload.",
          "cameraPermission": "Allow Match Mate to capture profile photos."
        }
      ],
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Match Mate to record voice messages in chat."
        }
      ],
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MatchMate to use Face ID to unlock your account quickly."
        }
      ],
      "expo-web-browser",
      "expo-iap"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3378719c-798c-4ae3-ae74-18602b1267eb",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    }
  }
}
