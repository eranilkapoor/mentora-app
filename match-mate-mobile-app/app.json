{
  "expo": {
    "name": "match-mate-mobile-app",
    "slug": "match-mate-mobile-app",
    "version": "1.0.0",
    "scheme": "matchmate",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.webnza.matchmate",
      "associatedDomains": [
        "applinks:matchmate.webnza.com",
        "applinks:www.matchmate.webnza.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "matchmate.webnza.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "www.matchmate.webnza.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "matchmate.webnza.com",
              "pathPrefix": "/magic-login"
            },
            {
              "scheme": "https",
              "host": "www.matchmate.webnza.com",
              "pathPrefix": "/magic-login"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "matchmate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "package": "com.webnza.matchmate"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3378719c-798c-4ae3-ae74-18602b1267eb"
      }
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow MatchMate to use your location to show nearby matrimonial matches."
        }
      ],
      "expo-font",
      "expo-video",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow MatchMate to use Face ID to unlock your account quickly."
        }
      ],
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3378719c-798c-4ae3-ae74-18602b1267eb",
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY"
    }
  }
}
