{
  "name": "match-mate-api-server",
  "version": "1.0.0",
  "description": "NestJS API server for MatchMate matrimonial, discovery, chat, settings, notification, and subscription workflows.",
  "author": "MatchMate",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run clean && nest build",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run clean && cross-env NODE_ENV=development nest start --watch",
    "start:debug": "npm run clean && nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main.js",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build:prod": "npm run build",
    "start:staging": "cross-env NODE_ENV=staging node dist/main.js",
    "smoke:local": "cross-env SMOKE_BASE_URL=http://localhost:3000 node ./scripts/smoke-api.mjs",
    "smoke:dev": "cross-env SMOKE_BASE_URL=http://localhost:3000 node ./scripts/smoke-api.mjs",
    "smoke:staging": "cross-env NODE_ENV=staging node ./scripts/smoke-api.mjs",
    "smoke:prod": "cross-env NODE_ENV=production node ./scripts/smoke-api.mjs",
    "smoke:providers": "node ./scripts/smoke-providers.mjs",
    "smoke:providers:strict": "cross-env SMOKE_STRICT=true node ./scripts/smoke-providers.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "env:validate": "ts-node -r tsconfig-paths/register src/config/validation.cli.ts",
    "migration:validate": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts validate",
    "migration:status": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts status",
    "migration:up": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts up",
    "migration:down": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts down",
    "migration:up:prod": "node dist/infrastructure/databases/mongo/migrations/migration.cli.js up",
    "migration:status:prod": "node dist/infrastructure/databases/mongo/migrations/migration.cli.js status",
    "index:audit": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/index-audit.cli.ts",
    "index:audit:strict": "npm run index:audit -- --strict",
    "index:audit:prod": "node dist/infrastructure/databases/mongo/index-audit.cli.js --strict",
    "archive:policy": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/archive-policy.cli.ts",
    "explain:audit": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/explain-audit.cli.ts",
    "fraud:scan": "ts-node -r tsconfig-paths/register src/modules/safety/fraud-scan.runner.ts",
    "deploy:prepare": "npm run build && npm run migration:up:prod && npm run index:audit:prod",
    "seed": "ts-node -r tsconfig-paths/register src/modules/seeder/seeder.runner.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
