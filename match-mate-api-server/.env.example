# Application
NODE_ENV=development
HOST=localhost
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://192.168.1.4:3000,http://192.168.1.4:8081
API_PREFIX=api
API_VERSION=1

# Database config
DB_DRIVER=mongo   # 'mongo' or 'local'
MONGO_URI=
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY=5000
RBAC_SYNC=false

# Cache config
CACHE_DRIVER=local   # 'redis' or 'local'
# Redis (only needed if CACHE_DRIVER=redis)
REDIS_HOST=redis-16858.crce283.ap-south-1-2.ec2.cloud.redislabs.com 
REDIS_PORT=16858
REDIS_PASS=OnN0c1EfIIMWlsy52BLxrZSz7LeZcQEr
REDIS_DB=0

# JWT
JWT_SECRET=123456789abcdef
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

#redis-cli -u redis://default:OnN0c1EfIIMWlsy52BLxrZSz7LeZcQEr@redis-16858.crce283.ap-south-1-2.ec2.cloud.redislabs.com:16858

# Storage config
STORAGE_DRIVER=local   # 'local' or 's3'
# AWS S3 (only needed if STORAGE_DRIVER=s3)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_BASE_URL=https://your-bucket-name.s3.ap-south-1.amazonaws.com

# API base URL (only needed if STORAGE_DRIVER=local)
API_BASE_URL=http://192.168.1.4:3000