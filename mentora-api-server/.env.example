# Application
NODE_ENV=
HOST=
PORT=
SHUTDOWN_DRAIN_MS=5000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:8081
CORS_MAX_AGE_SECONDS=86400
API_PREFIX=
API_VERSION=
API_BASE_URL=http://localhost:3000
APP_WEB_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3002
COOKIE_DOMAIN=

AUTH_EMAIL_PASSWORD_ENABLED=true
AUTH_PHONE_OTP_ENABLED=true
AUTH_REVIEW_PHONE_OTP_ENABLED=true
AUTH_REVIEW_PHONE_COUNTRY_CODE=
AUTH_REVIEW_PHONE=
AUTH_REVIEW_PHONE_OTP=

AUTH_SOCIAL_GOOGLE_ENABLED=true
AUTH_SOCIAL_FACEBOOK_ENABLED=true
AUTH_SOCIAL_APPLE_ENABLED=false
AUTH_MICROSOFT_ENABLED=false
AUTH_SAML_ENABLED=false
AUTH_SAML_METADATA_URL=
AUTH_MAGIC_LINK_ENABLED=true
AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_SUSPICIOUS_LOGIN_DETECTION_ENABLED=true

# Social auth / OAuth provider keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=/api/v1/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Database config
DB_DRIVER=mongo  # 'mongo' or 'local'
MONGO_URI=mongodb://localhost:27017/mentora
MONGO_RETRY_ATTEMPTS=5
MONGO_RETRY_DELAY=5000
MONGO_AUTO_INDEX= # defaults true in development and false in staging/production
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=45000
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_SLOW_QUERY_THRESHOLD_MS=200

# Cache config
CACHE_DRIVER=   # 'redis' or 'local'
# Redis (only needed if CACHE_DRIVER=redis)
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASS=
REDIS_DB=0

# Global throttle config
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Notification delivery setup
NOTIFICATION_QUEUE_ENABLED=
NOTIFICATION_QUEUE_NAME=notification-dispatch
NOTIFICATION_DLQ_NAME=notification-dispatch-dlq
NOTIFICATION_QUEUE_CONCURRENCY=5
NOTIFICATION_QUEUE_ATTEMPTS=5
NOTIFICATION_QUEUE_BACKOFF_MS=3000

NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_EMAIL_FROM=support@example.com
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_EMAIL_SES_REGION=
NOTIFICATION_EMAIL_SES_ACCESS_KEY_ID=
NOTIFICATION_EMAIL_SES_SECRET_ACCESS_KEY=
NOTIFICATION_EMAIL_SES_CONFIGURATION_SET=
NOTIFICATION_EMAIL_SMTP_DSN=
NOTIFICATION_EMAIL_SMTP_HOST=smtp.hostinger.com
NOTIFICATION_EMAIL_SMTP_PORT=465
NOTIFICATION_EMAIL_SMTP_USERNAME=
NOTIFICATION_EMAIL_SMTP_PASSWORD=
NOTIFICATION_EMAIL_SMTP_SECURE=true
NOTIFICATION_EMAIL_SMTP_REQUIRE_TLS=false
NOTIFICATION_EMAIL_SMTP_REJECT_UNAUTHORIZED=true
NOTIFICATION_EMAIL_SMTP_TIMEOUT_MS=15000

NOTIFICATION_SMS_ENABLED=false
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_SMS_MSG91_AUTH_KEY=
NOTIFICATION_SMS_MSG91_TEMPLATE_ID=
NOTIFICATION_SMS_MSG91_OTP_TEMPLATE_ID=
NOTIFICATION_SMS_MSG91_BASE_URL=https://control.msg91.com
NOTIFICATION_SMS_MSG91_TIMEOUT_MS=10000

NOTIFICATION_PUSH_ENABLED=false
NOTIFICATION_PUSH_PROVIDER=log
NOTIFICATION_PUSH_SERVER_KEY=
NOTIFICATION_PUSH_FCM_SERVICE_ACCOUNT_JSON=
NOTIFICATION_PUSH_FCM_SERVICE_ACCOUNT_PATH=
NOTIFICATION_PUSH_FCM_PROJECT_ID=
NOTIFICATION_PUSH_FCM_CLIENT_EMAIL=
NOTIFICATION_PUSH_FCM_PRIVATE_KEY=

CHAT_PROFANITY_FILTER_ENABLED=true
CHAT_PROFANITY_BLOCKED_WORDS=

# JWT config
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_AUDIENCE=user-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_AUDIENCE=user
JWT_ISSUER=mentora-api

# Payment config
PAYMENT_GST_PERCENTAGE=0
PAYMENT_SIGNATURE_SECRET=
PAYMENT_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_MOBILE_STORE_VERIFICATION_MODE=strict
PAYMENT_MOBILE_STORE_STRICT_VERIFICATION_ENABLED=true
GOOGLE_PLAY_PACKAGE_NAME=
# Raw JSON or base64-encoded Google Play service-account JSON.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./credentials/google-play-service-account.json
GOOGLE_PLAY_RTDN_ENABLED=false
GOOGLE_PLAY_RTDN_AUDIENCE=https://mentora.webnza.com/api/v1/payments/google-play/rtdn
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT_EMAIL=mentora-rtdn-push@your-gcp-project.iam.gserviceaccount.com

APPLE_STORE_ISSUER_ID=
APPLE_STORE_KEY_ID=
APPLE_STORE_BUNDLE_ID=
# App Store Connect .p8 private key; use escaped newlines in env files.
APPLE_STORE_PRIVATE_KEY=
APPLE_STORE_ENVIRONMENT=sandbox

# Enterprise CRM integrations
AI_PROVIDER_ENABLED=false
AI_PROVIDER=openai
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

WHATSAPP_PROVIDER_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=

DIALER_PROVIDER_ENABLED=false
DIALER_PROVIDER=
DIALER_PROVIDER_API_KEY=
DIALER_PROVIDER_BASE_URL=
DIALER_WEBHOOK_SECRET=

OCR_PROVIDER_ENABLED=false
OCR_PROVIDER=
OCR_PROVIDER_API_KEY=
OCR_PROVIDER_BASE_URL=

GEO_TELEMETRY_ENABLED=false
GEO_TELEMETRY_PROVIDER=google_maps
GEO_TELEMETRY_API_KEY=

WEBINAR_PROVIDER=
WEBINAR_PROVIDER_API_KEY=
WEBINAR_PROVIDER_BASE_URL=

ACCOUNTING_EXPORT_PROVIDER=
ACCOUNTING_EXPORT_API_KEY=
ACCOUNTING_EXPORT_BASE_URL=

# Storage config
STORAGE_DRIVER=local   # 'local' or 's3'
# AWS S3 (only needed if STORAGE_DRIVER=s3)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BASE_URL=

# Media safety / processing
MEDIA_AI_MODERATION_ENABLED=false
MEDIA_FFMPEG_PATH=
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600

# Monitoring / APM
MONITORING_ENABLED=false
MONITORING_PROVIDER=log
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
TRUST_PROXY_HOPS=0
