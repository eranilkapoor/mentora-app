{
  "name": "mentora-api-server",
  "version": "1.0.0",
  "description": "NestJS API server for Mentora AI tutoring, discovery, chat, settings, notification, and subscription workflows.",
  "author": "Mentora",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "npm run clean && cross-env NODE_ENV=development nest start --watch",
    "start:debug": "npm run clean && nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node -r ./scripts/register-dist-paths.cjs dist/main.js",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo tsconfig.tsbuildinfo",
    "build:prod": "npm run build",
    "start:staging": "cross-env NODE_ENV=staging node -r ./scripts/register-dist-paths.cjs dist/main.js",
    "smoke:local": "cross-env SMOKE_BASE_URL=http://localhost:3000 node ./scripts/smoke-api.mjs",
    "smoke:dev": "cross-env SMOKE_BASE_URL=http://localhost:3000 node ./scripts/smoke-api.mjs",
    "smoke:staging": "cross-env NODE_ENV=staging node ./scripts/smoke-api.mjs",
    "smoke:prod": "cross-env NODE_ENV=production node ./scripts/smoke-api.mjs",
    "smoke:providers": "node ./scripts/smoke-providers.mjs",
    "smoke:providers:strict": "cross-env SMOKE_STRICT=true node ./scripts/smoke-providers.mjs",
    "release:check": "node ./scripts/release-check.mjs",
    "env:validate": "ts-node -r tsconfig-paths/register src/config/validation.cli.ts",
    "migration:validate": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts validate",
    "migration:status": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts status",
    "migration:up": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts up",
    "migration:down": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/migrations/migration.cli.ts down",
    "migration:up:prod": "node -r ./scripts/register-dist-paths.cjs dist/infrastructure/databases/mongo/migrations/migration.cli.js up",
    "migration:status:prod": "node -r ./scripts/register-dist-paths.cjs dist/infrastructure/databases/mongo/migrations/migration.cli.js status",
    "db:reset": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/reset-database.cli.ts",
    "db:fresh": "cross-env RESET_DATABASE_CONFIRM=MENTORA_RESET npm run db:reset && npm run migration:up && npm run seed",
    "index:audit": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/index-audit.cli.ts",
    "index:audit:strict": "npm run index:audit -- --strict",
    "index:audit:prod": "node -r ./scripts/register-dist-paths.cjs dist/infrastructure/databases/mongo/index-audit.cli.js --strict",
    "index:sync": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/index-sync.cli.ts",
    "index:sync:prod": "node -r ./scripts/register-dist-paths.cjs dist/infrastructure/databases/mongo/index-sync.cli.js",
    "archive:policy": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/archive-policy.cli.ts",
    "explain:audit": "ts-node -r tsconfig-paths/register src/infrastructure/databases/mongo/explain-audit.cli.ts",
    "fraud:scan": "ts-node -r tsconfig-paths/register src/modules/safety/fraud-scan.runner.ts",
    "deploy:prepare": "npm run build && npm run migration:up:prod && npm run index:audit:prod",
    "seed": "ts-node -r tsconfig-paths/register src/modules/seeder/seeder.runner.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/client-sesv2": "^3.1111.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@sentry/node": "^10.70.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.1.2",
    "mentora-app": "file:..",
    "mongoose": "^9.9.2",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/passport-facebook": "^3.0.4",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-instagram": "^1.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.11.0",
    "jest": "^30.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "js-yaml": "^4.1.1",
    "multer": "^2.2.0",
    "uuid": "^11.1.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": {
            "ignoreCodes": [
              151002
            ]
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.spec.ts",
      "!**/*.interface.ts",
      "!**/*.module.ts",
      "!**/*.dto.ts",
      "!**/*.schema.ts",
      "!**/*.enum.ts",
      "!**/*.constants.ts",
      "!**/main.ts",
      "!**/config/**",
      "!**/template-samples/**",
      "!**/data/**"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "branches": 11,
        "functions": 23,
        "lines": 30,
        "statements": 31
      }
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
